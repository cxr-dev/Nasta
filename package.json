    "@tsconfig/svelte": "^5.0.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
