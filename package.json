{
  "name": "nasta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://cxr-dev.github.io/nasta",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "predev": "node scripts/fetch-events-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-png-icons.mjs && node scripts/fetch-events-data.mjs",
    "build": "vite build",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
